#!/usr/bin/env bash
# Re-runs attempt {{attempt}} of Paper2Proof run {{run_id}} on this machine, with the same
# runner image (by digest), workspace and exec manifest as the experiment job that was judged.
#
#   ./reproduce.sh <staging dir>
#
# <staging dir> must hold the archives listed below with these exact sha256 digests. They are
# not in the bundle (size); within 24 h of the run they are in the run bucket under staging/.
# Check the bundle first: uv run python -m app.bundle.verify <bundle> (Paper2Proof repository).
# Needs Linux, Docker and sha256sum. With an NVIDIA GPU (and the NVIDIA Container Toolkit) the
# job gets every GPU; without one it runs on CPU, as runs judged in a Token Factory Sandbox did.
#
# WARNING: this runs code written by a model and code from the paper's repository. Run it only
# on an isolated, disposable machine (never a developer laptop or a control-plane host). The
# container gets no network, no capabilities and no privilege escalation.
set -euo pipefail

RUNNER_IMAGE={{runner_image}}
ATTEMPT={{attempt}}
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST="$HERE/code/exec_manifest_${ATTEMPT}.json"

if [ "$#" -ne 1 ] || [ ! -d "$1" ]; then
  echo "usage: $0 <staging dir with the archives listed in this script>" >&2
  exit 2
fi
STAGING="$(cd "$1" && pwd)"

if [ ! -f "$HERE/code/workspace.tar" ] || [ ! -f "$MANIFEST" ]; then
  echo "this bundle has no code/workspace.tar or exec manifest: nothing to re-run" >&2
  exit 2
fi
echo "WARNING: this runs untrusted code (model-written and from the paper's repository)." >&2
if [ "${P2P_REPRODUCE_YES:-}" != "1" ]; then
  read -r -p "Is this an isolated, disposable machine? [y/N] " answer
  [ "$answer" = "y" ] || exit 1
fi
cp "$HERE/code/workspace.tar" "$STAGING/workspace.tar"

echo "checking archive digests in $STAGING"
(
  cd "$STAGING"
  sha256sum --check --strict <<'SHA256SUMS'
{{checksums}}
SHA256SUMS
)

mkdir -p "$STAGING/results"
chmod 0777 "$STAGING/results"  # the container has no CAP_DAC_OVERRIDE
gpus=()
if command -v nvidia-smi > /dev/null 2>&1; then gpus=(--gpus all); fi
echo "running $RUNNER_IMAGE (no network, ${gpus[*]:-CPU only})"
docker run --rm "${gpus[@]}" --network none \
  --cap-drop ALL --security-opt no-new-privileges --pids-limit 4096 \
  --volume "$MANIFEST:/etc/p2p/manifest.json:ro" \
  --volume "$STAGING:/mnt/run/staging:ro" \
  --volume "$STAGING/results:/mnt/run/results" \
  --tmpfs /mnt/cache \
  "$RUNNER_IMAGE"

echo "results: $STAGING/results/$ATTEMPT/results.json (compare with verdict.json)"
