{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2proof.dev/schemas/manifest.schema.json",
  "title": "p2p.manifest/v2 \u2014 exec job manifest (injected, <= 64 KiB)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "attempt",
    "image_digest",
    "entrypoint",
    "args",
    "seeds",
    "budget_seconds",
    "paths",
    "claims",
    "scale",
    "archives",
    "workspace_sha256"
  ],
  "properties": {
    "schema": {
      "const": "p2p.manifest/v2"
    },
    "run_id": {
      "type": "string",
      "pattern": "^r_[0-9a-z]{26}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^workspace/(?!.*\\.\\.)[A-Za-z0-9_./-]+\\.py$"
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200,
        "not": {
          "pattern": "^(--(s|se|see|seed|sm|smo|smok|smoke|o|ou|out)(=.*)?$|-[A-Za-z]*[so]|@)"
        }
      },
      "maxItems": 20
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true
    },
    "budget_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 1800
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay",
        "repo",
        "data_dir",
        "workspace",
        "cache",
        "results"
      ],
      "properties": {
        "overlay": {
          "type": "string"
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_dir": {
          "type": "string"
        },
        "workspace": {
          "type": "string",
          "description": "the workspace archive (tar), extracted by the runner to local disk"
        },
        "cache": {
          "type": "string"
        },
        "results": {
          "type": "string"
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "description": "every claim the job measures; claim_ref is unique (checked by the model)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_ref",
          "claim_type",
          "metric",
          "higher_is_better",
          "metric_key",
          "baseline_name",
          "baseline_key"
        ],
        "properties": {
          "claim_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "claim_type": {
            "enum": [
              "ABSOLUTE",
              "RELATIVE"
            ]
          },
          "metric": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "the claim's metric name (tolerances in config/verdict.yaml)"
          },
          "higher_is_better": {
            "type": "boolean"
          },
          "metric_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,63}$",
            "description": "the metrics.json key the experiment writes the claim's value under"
          },
          "baseline_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "baseline_key": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,63}$",
            "description": "the metrics.json key of the baseline's value (RELATIVE only)"
          }
        },
        "if": {
          "properties": {
            "claim_type": {
              "const": "RELATIVE"
            }
          }
        },
        "then": {
          "properties": {
            "baseline_name": {
              "type": "string",
              "minLength": 1
            },
            "baseline_key": {
              "type": "string"
            }
          }
        },
        "else": {
          "properties": {
            "baseline_name": {
              "type": "null"
            },
            "baseline_key": {
              "type": "null"
            }
          }
        }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full"
      ],
      "properties": {
        "full": {
          "type": "boolean"
        },
        "fraction_of_data": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "epochs": {
          "type": "integer",
          "minimum": 1
        },
        "paper_epochs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "archives": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay",
        "repo",
        "data"
      ],
      "description": "sha256 of every archive the runner extracts, from the validated provision report",
      "properties": {
        "overlay": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repo": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "data": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,200}$",
                "not": {
                  "pattern": "^\\.+$"
                }
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "workspace_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of paths.workspace (a plain tar of the Coder's workspace, the bytes of the last passing smoke run)"
    }
  }
}
