# Copy to .env (gitignored) and fill in. NEVER commit .env.
P2P_ENV=dev                          # test | dev | prod

# Token Factory
NEBIUS_API_KEY=
TF_PROJECT_ID=                       # Token Factory project id (Sandboxes "Project" header)

# Tavily
TAVILY_API_KEY=

# Nebius AI Cloud (dev: only needed for live tests and spikes)
NEBIUS_CONTROL_PROJECT_ID=
NEBIUS_SANDBOX_PROJECT_ID=
NEBIUS_REGION=eu-north1
SUBNET_PROVISION_ID=
SUBNET_EXEC_ID=
SUBNET_CONTROL_ID=
GATEWAY_INSTANCE_ID=
REGISTRY_CONTROL=                    # e.g. cr.eu-north1.nebius.cloud/<registry-id>
REGISTRY_SANDBOX=
NEBIUS_STORAGE_HOST=                 # S3 endpoint host for eu-north1 (from spike S5/S11)
NEBIUS_REGISTRY_HOST=

# Service account credentials (prod: injected from SecretStash, never set here in prod)
JOB_LAUNCHER_AUTH_KEY_FILE=          # path to the authorized key JSON, outside the repo
JOB_LAUNCHER_S3_KEY_ID=
JOB_LAUNCHER_S3_SECRET=
RUNTIME_S3_KEY_ID=                   # dev: any value, also used by the local SeaweedFS
RUNTIME_S3_SECRET=                   # dev: openssl rand -hex 16

# App
SESSION_KEY=                         # openssl rand -hex 32
ADMIN_TOKEN=                         # openssl rand -hex 32
DB_URL=sqlite+aiosqlite:///./var/p2p.db
P2P_GPU_PREEMPTIBLE=true

# Dev storage (SeaweedFS S3 from docker-compose.dev.yml)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
