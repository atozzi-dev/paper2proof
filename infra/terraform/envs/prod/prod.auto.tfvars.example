# Copy to prod.auto.tfvars (gitignored) and fill in. IDs only: never put a secret in this file.
# Secrets reach Terraform only as TF_VAR_* environment variables marked ephemeral (pg_password).

control_project_id = "project-..." # p2p-control
sandbox_project_id = "project-..." # p2p-sandbox

# Override if spike S-11 shows bucket names are global and these are taken.
# state_bucket_name   = "p2p-state"
# bundles_bucket_name = "p2p-bundles"
# cache_bucket_name   = "p2p-cache"

# Must sit inside the private pool of a new network in eu-north1 (spike S-5 / H-04).
# provision_cidr = "10.1.0.0/24"
# exec_cidr      = "10.1.1.0/24"
# gateway_cidr   = "10.1.2.0/27"

enable_managed_pg = false
