      "EventEnvelope": {
        "additionalProperties": false,
        "description": "One stored event; `id` is the monotonic SSE id used for Last-Event-ID resumption.",
        "properties": {
          "id": {
            "minimum": 1.0,
            "title": "Id",
            "type": "integer"
          },
          "payload": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunStatusPayload"
              },
              {
                "$ref": "#/components/schemas/StepStartedPayload"
              },
              {
                "$ref": "#/components/schemas/StepFinishedPayload"
              },
              {
                "$ref": "#/components/schemas/ClaimExtractedPayload"
              },
              {
                "$ref": "#/components/schemas/PlanReadyPayload"
              },
              {
                "$ref": "#/components/schemas/ApprovalRequiredPayload"
              },
              {
                "$ref": "#/components/schemas/ModelCallPayload"
              },
              {
                "$ref": "#/components/schemas/SandboxOutputPayload"
              },
              {
                "$ref": "#/components/schemas/JobStatusPayload"
              },
              {
                "$ref": "#/components/schemas/JobLogPayload"
              },
              {
                "$ref": "#/components/schemas/EgressBlockedPayload"
              },
              {
                "$ref": "#/components/schemas/VerdictReadyPayload"
              },
              {
                "$ref": "#/components/schemas/CostUpdatePayload"
              },
              {
                "$ref": "#/components/schemas/WarningPayload"
              },
              {
                "$ref": "#/components/schemas/ErrorPayload"
              }
