          "id",
          "run_id",
          "ts",
          "type",
          "payload"
        ],
        "title": "EventEnvelope",
        "type": "object"
      },
      "EventType": {
        "enum": [
          "run.status",
          "step.started",
          "step.finished",
          "claim.extracted",
          "plan.ready",
          "approval.required",
          "model.call",
          "sandbox.output",
          "job.status",
          "job.log",
          "egress.blocked",
          "verdict.ready",
          "cost.update",
