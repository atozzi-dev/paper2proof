# Non-secret settings of the p2p-api endpoint (copy to deploy/prod.env, which is gitignored).
# Values come from the Terraform outputs (H-04) and the image digests of the deploy (A-05).
# Secrets never go here: deploy/endpoint.sh accepts only the keys below, and needs every
# uncommented one except S3_REGION and GATEWAY_INSTANCE_ID.
S3_ENDPOINT=https://storage.eu-north1.nebius.cloud
S3_REGION=eu-north1
P2P_STATE_BUCKET=p2p-state
P2P_CONTROL_BUCKET=p2p-bundles
NEBIUS_SANDBOX_PROJECT_ID=project-...
P2P_PROVISIONER_IMAGE=cr.eu-north1.nebius.cloud/<registry>/p2p-provisioner@sha256:...
P2P_RUNNER_IMAGE=cr.eu-north1.nebius.cloud/<registry>/p2p-runner@sha256:...
P2P_RUNNER_CPU_IMAGE=cr.eu-north1.nebius.cloud/<registry>/p2p-runner-cpu@sha256:...
P2P_SUBNET_PROVISION=vpcsubnet-...
P2P_SUBNET_EXEC=vpcsubnet-...
P2P_GPU_PREEMPTIBLE=false
P2P_BUNDLE_KEY_ID=kms-key-id
GATEWAY_INSTANCE_ID=computeinstance-...
# The endpoint proxy's CIDR, measured in H-05 (docs/DEPLOY.md, item 8). Without it the per-IP
# limits see every client as the proxy. Never 0.0.0.0/0; several CIDRs are separated by ";".
# P2P_FORWARDED_ALLOW_IPS=10.0.0.0/8
# Observability (A-28, docs/DEPLOY.md): traces to Nebius Tracing over OTLP/gRPC, metrics to an
# OpenTelemetry Collector (Nebius has no direct OTLP metrics write). Leave out to disable.
# OBSERVABILITY_STATIC_KEY must then be in the Nebius secret.
# P2P_TRACES_ENDPOINT=https://write.tracing.eu-north1.nebius.cloud:443
# OBSERVABILITY_PROJECT_ID=project-...
# P2P_METRICS_ENDPOINT=https://<collector>:4317   (no collector is deployed yet)
