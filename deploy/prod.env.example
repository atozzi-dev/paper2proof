# Non-secret settings of the p2p-api endpoint (copy to deploy/prod.env, which is gitignored).
# Values come from the Terraform outputs (H-04) and the image digests of the deploy (A-05).
# Secrets never go here: deploy/endpoint.sh refuses secret-looking names.
S3_ENDPOINT=https://storage.eu-north1.nebius.cloud
S3_REGION=eu-north1
P2P_STATE_BUCKET=p2p-state
P2P_CONTROL_BUCKET=p2p-bundles
NEBIUS_SANDBOX_PROJECT_ID=project-...
P2P_PROVISIONER_IMAGE=cr.eu-north1.nebius.cloud/<registry>/p2p-provisioner@sha256:...
P2P_RUNNER_IMAGE=cr.eu-north1.nebius.cloud/<registry>/p2p-runner@sha256:...
P2P_RUNNER_CPU_IMAGE=cr.eu-north1.nebius.cloud/<registry>/p2p-runner-cpu@sha256:...
P2P_SUBNET_PROVISION=vpcsubnet-...
P2P_SUBNET_EXEC=vpcsubnet-...
P2P_GPU_PREEMPTIBLE=false
P2P_BUNDLE_KEY_ID=kms-key-id
GATEWAY_INSTANCE_ID=computeinstance-...
